# Copy this file to .env.local and fill in the values from the Supabase
# dashboard (Project Settings, API). .env.local is never committed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-side only, never a NEXT_PUBLIC name. The service role key, used by
# route handlers that act for the system (the Stripe webhook).
SUPABASE_SECRET_KEY=sb_secret_your_key

# Stripe, test mode (Developers, API keys). The webhook secret comes from the
# endpoint registered in the Stripe dashboard, or from `stripe listen` for
# local dev. The price id is the recurring monthly price on the
# Accessible Menu product.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PRICE_ID=price_your_price

# The address finder on the restaurant form (D-83). Server-side only, never
# a NEXT_PUBLIC name: a Google Cloud key restricted to Places API (New).
# Unset, the form has no finder and the owner types the address by hand.
# GOOGLE_PLACES_API_KEY=
# tests/local only: where the stand-in's fake Places endpoints answer. Leave
# it unset everywhere else.
# GOOGLE_PLACES_ORIGIN=http://127.0.0.1:54400

# The origin menu links are printed with (D-88): an https origin, no path.
# Required in production; the build fails without it. Previews fall back to
# their own Vercel URL and local dev to http://localhost:3000, so leave it
# unset until the menu domain is decided (Q-1).
# MENU_ORIGIN=https://menus.example

# Only to run the owner pages of the a11y gate locally, signed in as the
# test owner (D-100): A11Y_SCOPE=owner npm run a11y. The password comes from
# the password manager by read -s, never through chat. Everything else in
# the gate runs without these.
# A11Y_OWNER_EMAIL=test-owner@example.com
# A11Y_OWNER_PASSWORD=
# A11Y_OWNER_CODE=12345678
